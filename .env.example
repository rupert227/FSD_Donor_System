# Environment Variables Template
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authentication / Session Secret
AUTH_SECRET=your_auth_secret_here

# Optional: Direct PostgreSQL connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Email (Send proposal). Leave MAIL_MODE unset for dry-run: the email is built but nothing is delivered.
#   MAIL_MODE=redirect  sends every email to MAIL_TEST_RECIPIENT instead of the prospect (use this to test)
#   MAIL_MODE=send      delivers to the real prospect (production only)
MAIL_MODE=
MAIL_TEST_RECIPIENT=
# The sending Gmail account and its app password (Google Account > Security > App passwords).
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Caritas Manila
# Optional: only set these to use a service other than Gmail. Leave them out otherwise
# (an empty value is NOT the same as unset). The defaults are smtp.gmail.com and 465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
